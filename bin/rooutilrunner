#!/bin/bash

#
# rooutilrunner
#

# Some global settings
MAX_JOBS=20

# Default inputs
DEBUG=0
MACRO_FILE="unknown"
FILELIST="unknown"
N_JOBS=1
OUTDIR="unknown"

usage() {

   cat << EOF

   A script to run your RooUtil macro over a large number of files in parallel. This will:
     - compile your macro into a C++ program,
     - split your filelist into smaller files,
     - submit parallel jobs, and
     - combine the output ROOT files

   rooutilrunner [-h|--help] [-m|--macro MACRO_NAME] [-v|--verbose] [-f|--filelist FILELIST] [-n|--njobs NJOBS] [-o|--outdir OUTDIR]


   Arguments:
   -h, --help: print help
   -m, --macro: macro.C file that you want to run in parallel
   -v, --verbose: debug output
   -f, --filelist: filelist containing list of files that you want to process
   -n, --njobs: number of jobs to run in parallel (default: ${N_JOBS}, max: ${MAX_JOBS})
   -o, --outdir: directory for output to go
EOF
}

vars=$(getopt -o hm:vf:n:o: --long help,macro:,verbose,filelist:,njobs:,outdir: -- "$@")
eval set -- "$vars"

for opt; do
    case "$opt" in
      -h|--help)
          usage
	  exit 0
        ;;
      -m|--macro)
	MACRO_FILE=$2
        shift 2
        ;;
      -v|--verbose)
	DEBUG=1
        shift 
        ;;
      -f|--filelist)
	FILELIST=$2
        shift 2
        ;;
      -n|--njobs)
	N_JOBS=$2
        shift 2
        ;;
      -o|--outdir)
	OUTDIR=$2
        shift 2
        ;;
    esac
done

#
# Make sure we are not on the mu2egpvms
#
HOSTNAME=`hostname`
if [[ ${DEBUG} -eq 1 ]]; then
    echo "debug: HOSTNAME=${HOSTNAME}"
fi
if [[ ${HOSTNAME} == *"mu2egpvm"* ]]; then
    echo "Error: This script should not be run on the mu2egpvms. Run it on the EAF"
    exit 1
fi

#
# Check input arguments
#
echo "Checking input arguments..."
BAD_ARGS=0

# Check that a macro file was supplied and that it exists
if [[ ${MACRO_FILE} == "unknown" ]]; then
    echo "Error: Please supply a macro with -m or --macro argument."
    BAD_ARGS=1
elif [[ ! -f ${MACRO_FILE} ]]; then
    echo "Error: Cannot find file \"${MACRO_FILE}\" supplied by -m or --macro argument"
    BAD_ARGS=1
fi
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: MACRO_FILE=${MACRO_FILE}"
fi

# Now check the filelist was supplied and exists
if [[ ${FILELIST} == "unknown" ]]; then
    echo "Error: Please supply a filelist with -f or --filelist argument."
    BAD_ARGS=1
elif [[ ! -f ${FILELIST} ]]; then
    echo "Error: Cannot find filelist \"${FILELIST}\" supplied by -f or --filelist argument"
    BAD_ARGS=1
fi
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: FILELIST=${FILELIST}"
fi

# Now check the number of jobs
if [[ ${N_JOBS} -gt ${MAX_JOBS} ]]; then
    echo "Warning: ${N_JOBS} > ${MAX_JOBS}. Setting N_JOBS=${MAX_JOBS}"
    N_JOBS=${MAX_JOBS}
elif [[ ${N_JOBS} -le 0 ]]; then
    echo "Warning: ${N_JOBS} <=0. Setting N_JOBS=1"
    N_JOBS=1
fi
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: N_JOBS=${N_JOBS}"
fi

# Now check the output directory
if [[ ${OUTDIR} == "unknown" ]]; then
    echo "Error: Please supply an output directory with -o or --outdir argument."
    BAD_ARGS=1
elif [[ ! -d ${OUTDIR} ]]; then
    echo "Error: Cannot find directory \"${OUTDIR}\" supplied by -o or --outdir argument"
    BAD_ARGS=1
fi
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: OUTDIR=${OUTDIR}"
fi

if [[ $BAD_ARGS -eq 1 ]]; then
    echo "Problem(s) with input arguments. Quitting."
    exit 1
fi
echo "Input arguments are OK"

#
# We will want to call the function from within a program
# The function name should be the same as the file name
#
MACRO_FUNCTION=`echo ${MACRO_FILE##*/} | cut -d '.' -f 1` # special arguments to get macro.C from something that might contain a path, then remove the .C
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: MACRO_FUNCTION=${MACRO_FUNCTION}"
fi

echo "Will run ${MACRO_FILE} over ${FILELIST} in ${N_JOBS} jobs"
echo ""


#
# Now create the subfilelists
#
rm sublist*.txt
split --numeric-suffixes=1 --additional-suffix=.txt -n l/${N_JOBS} ${FILELIST} sublist # start at 01
if [ ${DEBUG} -eq 1 ]; then
    echo "debug: files per subfilelist"
    echo "debug: output of wc -l sublist*.txt:"
    wc -l sublist*.txt
fi

#
# Now we'll compile the macro into a program
#

# First, need to get the ROOT_INCLUDE_PATH in order to compile the macro
OLDIFS="$IFS"
IFS=':' tokens=( $ROOT_INCLUDE_PATH )
INC_PATHS=""
for INC_PATH in "${tokens[@]}"; do
    INC_PATHS=${INC_PATHS}" -I"$INC_PATH
done
IFS="$OLDIFS" # restore IFS
if [[ ${DEBUG} -eq 1 ]]; then
    echo "debug: INC_PATHS=${INC_PATHS}"
fi

# Add the macro to a new file and also a main function so we can run this as a program
# We are assuming that the function has two string arguments for the input file(list) and output file
cat ${MACRO_FILE} > macro.cxx
echo "

int main(int argc, char* argv[]) {
   $MACRO_FUNCTION(argv[1], argv[2]);
   return 0;
}

" >> macro.cxx

# Compile the program
echo "Compiling..."
g++ macro.cxx $(root-config --cflags --libs) ${INC_PATHS} -o macro
if [ $? -ne 0 ]; then
    echo "Compilation failed."
    exit 1
fi
echo "Done"
echo ""

#
# Now run all the jobs in parallel
#
# Run the program in parallel with different outputs
echo "Starting ${N_JOBS} jobs..."
for i in $(seq -f "%02g" 1 ${N_JOBS}); do
    ./macro sublist${i}.txt ${OUTDIR}/output_N${i}.root >& output_N${i}.log &
    if [[ ${DEBUG} -eq 1 ]]; then
	echo "Job ${i} started"
    fi
done
echo "All jobs started."
echo "Jobs running..."

# Want to wait for programs to finish
wait
echo "All jobs finished"
echo ""

#
# Now combine the outputs
#
# Combine the outputs
# TODO: explore the -j option to hadd to parallelize this step too
echo "Hadding output files..."
hadd -v ${DEBUG} -f ${OUTDIR}/output_full.root ${OUTDIR}/output_N*.root

# Clean up
rm ${OUTDIR}/output_N*.root

echo ""
echo "All done!"
